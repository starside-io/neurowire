{
  "name": "@neurowire/mcp",
  "version": "0.1.0",
  "description": "MCP server that gives LLM agents clean feeds, meshes, journals, and tap verification from Neurowire.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "neurowire-mcp": "./dist/index.js"
  },
  "mcpName": "io.starside/neurowire",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "neurowire",
    "mcp",
    "model-context-protocol",
    "agent",
    "feed",
    "rss",
    "atom",
    "json-feed",
    "mesh"
  ],
  "author": "Médéric Burlet <mederic.burlet@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starside-io/neurowire.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/starside-io/neurowire#readme",
  "bugs": {
    "url": "https://github.com/starside-io/neurowire/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.30.0",
    "@neurowire/core": "workspace:*",
    "@neurowire/ingest": "workspace:*",
    "@neurowire/tap-wizard": "workspace:*",
    "@neurowire/taps": "workspace:*",
    "@neurowire/taps-pack": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
